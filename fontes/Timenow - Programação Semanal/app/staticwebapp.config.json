{
    "navigationFallback": {
        "rewrite": "/index.html"
    },
    "routes": [
        {
            "route": "/api/dados/v1/*",
            "allowedRoles": [
                "anonymous"
            ]
        },
        {
            "route": "/api/*",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/_views/*",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/_components/*",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/ds/*",
            "headers": {
                "Cache-Control": "public, max-age=3600"
            }
        },
        {
            "route": "/lib/*",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        }
    ],
    "responseOverrides": {
        "404": {
            "rewrite": "/index.html"
        },
        "401": {
            "statusCode": 302,
            "redirect": "/.auth/login/aad"
        }
    },
    "globalHeaders": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
    }
}
